{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "import"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  },
  "overrides": [
    {
      "files": ["src/creator/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          { "patterns": [{ "group": ["**/follower/**"], "message": "creator は follower を import しない（shared を経由する）" }] }
        ]
      }
    },
    {
      "files": ["src/follower/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          { "patterns": [{ "group": ["**/creator/**"], "message": "follower は creator を import しない（shared を経由する）" }] }
        ]
      }
    },
    {
      "files": ["src/shared/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          { "patterns": [{ "group": ["**/creator/**", "**/follower/**"], "message": "shared は creator / follower を import しない" }] }
        ]
      }
    }
  ]
}
