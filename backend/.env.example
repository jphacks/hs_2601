# コピーして .env を作成する（.env は git 管理外）
#   cp .env.example .env

# Google Cloud: Geocoding API / Routes API / Street View Static API を有効化したキー
GOOGLE_MAPS_API_KEY=

# --- VLM（ステップ 7: 目印の抽出） ---
# 既定は Gemini。Google AI Studio（https://aistudio.google.com）で発行する無料枠のキー。
# Maps のキーとは別物。課金登録は不要。
GEMINI_API_KEY=
# Claude を使う場合のみ（https://console.anthropic.com、前払いクレジットが必要）
ANTHROPIC_API_KEY=
# どちらを使うか: gemini | claude
VLM_PROVIDER=gemini
# モデル名（省略時: gemini-3.5-flash / claude なら claude-haiku-4-5 などを指定）
VLM_MODEL=gemini-3.5-flash

# 経路探索の出力先（省略時 backend/out）
# OUT_DIR=./out

# --- Supabase（ステップ 9: 写真列の保存・公開） ---
# ダッシュボード Settings → API、または `supabase projects api-keys --project-ref <ref> --reveal`
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=        # サーバー専用。フロントに渡さない
SUPABASE_ANON_KEY=                # 参加者フロントが直接読むとき用（任意）
# 参加者向け URL の土台（任意）。公開時に {PUBLIC_BASE_URL}/r/{id} を表示する
# 未設定なら qr.png は出さない。フロントのデプロイ前は開発サーバーの URL でよい
PUBLIC_BASE_URL=http://localhost:5173
