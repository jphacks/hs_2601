
"use client";

import { useRef, useState } from "react";

type Photo = {
  id: string;
  file: File;
  preview: string;
  lat?: number;
  lng?: number;
};

type Route = {
  id: string;
  start: string;
  goal: string;
  published: boolean;
};

export default function Home() {
  const [screen, setScreen] = useState("home");
  const [start, setStart] = useState("");
  const [goal, setGoal] = useState("");
  const [photos, setPhotos] = useState<Photo[]>([]);
  const [routes, setRoutes] = useState<Route[]>([]);
  const [selected, setSelected] = useState<string[]>([]);
  const [activeRoute, setActiveRoute] = useState<Route | null>(null);
  const [loading, setLoading] = useState(false);
  const fileRef = useRef<HTMLInputElement>(null);

  function addPhotos(files: FileList | null) {
    if (!files) return;

    Array.from(files).forEach((file) => {
      if (!file.type.startsWith("image/")) return;

      const photo: Photo = {
        id: crypto.randomUUID(),
        file,
        preview: URL.createObjectURL(file),
      };

      setPhotos((old) => [...old, photo]);

      navigator.geolocation?.getCurrentPosition(
        (position) => {
          setPhotos((old) =>
            old.map((p) =>
              p.id === photo.id
                ? {
                    ...p,
                    lat: position.coords.latitude,
                    lng: position.coords.longitude,
                  }
                : p
            )
          );
        },
        () => {
          console.log("位置情報を取得できませんでした");
        },
        { enableHighAccuracy: true, timeout: 10000 }
      );
    });

    if (fileRef.current) fileRef.current.value = "";
  }

  function createRoute() {
    if (!start.trim() || !goal.trim()) {
      alert("出発地と目的地を入力してください");
      return;
    }
    if (photos.length === 0) {
      alert("目印となる写真を撮影してください");
      return;
    }

    setLoading(true);
    setScreen("loading");

    // 現段階では画面の動作確認用。
    // 後からバックエンドの作成 API に置き換えます。
    setTimeout(() => {
      const route: Route = {
        id: crypto.randomUUID(),
        start,
        goal,
        published: false,
      };
      setRoutes((old) => [...old, route]);
      setActiveRoute(route);
      setLoading(false);
      setScreen("detail");
    }, 1000);
  }

  function publishRoutes() {
    setRoutes((old) =>
      old.map((r) =>
        selected.includes(r.id) ? { ...r, published: true } : r
      )
    );
    setScreen("published");
  }

  const button =
    "w-full rounded-xl bg-emerald-700 px-4 py-3 font-semibold text-white";
  const secondary =
    "w-full rounded-xl border border-stone-300 bg-white px-4 py-3 font-medium";
  const input =
    "w-full rounded-xl border border-stone-300 bg-white px-4 py-3";

  return (
    <main className="min-h-screen bg-stone-50 px-4 py-6 text-stone-900">
      <div className="mx-auto max-w-lg">
        <header className="mb-7 flex items-center justify-between">
          <button
            onClick={() => setScreen("home")}
            className="text-left"
          >
            <p className="text-sm font-bold tracking-widest text-emerald-700">
              WAYFINDER
            </p>
            <p className="text-xs text-stone-500">写真でつなぐ道案内</p>
          </button>
          {screen !== "home" && (
            <button
              onClick={() => setScreen("home")}
              className="text-sm text-stone-500"
            >
              ホームへ
            </button>
          )}
        </header>

        {screen === "home" && (
          <section className="space-y-4">
            <h1 className="text-3xl font-bold">道案内をつくろう</h1>
            <p className="text-sm leading-6 text-stone-600">
              迷いやすい場所を写真に撮って、誰でも歩ける道案内を作ります。
            </p>
            <button
              onClick={() => setScreen("create")}
              className={`${button} py-6 text-left`}
            >
              <span className="block text-2xl">📷</span>
              <span className="mt-3 block text-xl">道を作る</span>
              <span className="mt-1 block text-sm font-normal">
                出発地・目的地・目印の写真を登録
              </span>
            </button>
            <button
              onClick={() => setScreen("routes")}
              className={`${secondary} py-6 text-left`}
            >
              <span className="block text-2xl">🔗</span>
              <span className="mt-3 block text-xl">作った道を公開する</span>
              <span className="mt-1 block text-sm text-stone-500">
                作成済みの道を選んで共有
              </span>
            </button>
          </section>
        )}

        {screen === "create" && (
          <section className="space-y-5">
            <h1 className="text-2xl font-bold">道を作る</h1>
            <label className="block space-y-2">
              <span className="text-sm font-semibold">出発地</span>
              <input
                className={input}
                value={start}
                onChange={(e) => setStart(e.target.value)}
                placeholder="例：広島駅"
              />
            </label>
            <label className="block space-y-2">
              <span className="text-sm font-semibold">目的地</span>
              <input
                className={input}
                value={goal}
                onChange={(e) => setGoal(e.target.value)}
                placeholder="例：平和記念公園"
              />
            </label>

            <div className="space-y-3 rounded-2xl border border-stone-200 bg-white p-4">
              <div>
                <h2 className="font-bold">目印の写真</h2>
                <p className="mt-1 text-sm text-stone-500">
                  曲がり角や入口など、迷いやすい場所を撮影してください。
                </p>
              </div>

              <input
                ref={fileRef}
                type="file"
                accept="image/*"
                capture="environment"
                multiple
                className="hidden"
                onChange={(e) => addPhotos(e.target.files)}
              />

              <button
                className={button}
                onClick={() => fileRef.current?.click()}
              >
                📷 写真を撮る・追加する
              </button>

              {photos.length === 0 ? (
                <div className="rounded-xl bg-stone-50 p-6 text-center text-sm text-stone-500">
                  まだ写真がありません
                </div>
              ) : (
                <div className="grid grid-cols-2 gap-3">
                  {photos.map((photo, index) => (
                    <div key={photo.id} className="overflow-hidden rounded-xl border">
                      <img
                        src={photo.preview}
                        alt={`目印 ${index + 1}`}
                        className="h-36 w-full object-cover"
                      />
                      <div className="p-2">
                        <p className="text-xs font-medium">
                          目印 {index + 1}
                        </p>
                        <p className="mt-1 text-xs text-stone-500">
                          {photo.lat !== undefined
                            ? "位置情報取得済み"
                            : "位置情報未取得"}
                        </p>
                        <button
                          className="mt-2 text-sm text-red-600"
                          onClick={() => {
                            URL.revokeObjectURL(photo.preview);
                            setPhotos((old) =>
                              old.filter((p) => p.id !== photo.id)
                            );
                          }}
                        >
                          削除
                        </button>
                      </div>
                    </div>
                  ))}
                </div>
              )}
            </div>

            <button className={button} onClick={createRoute}>
              道案内を作成する
            </button>
            <button
              className={secondary}
              onClick={() => setScreen("home")}
            >
              キャンセル
            </button>
          </section>
        )}

        {screen === "loading" && (
          <section className="py-20 text-center">
            <div className="mx-auto mb-5 h-10 w-10 animate-spin rounded-full border-4 border-stone-200 border-t-emerald-700" />
            <h1 className="text-xl font-bold">道案内を作成中...</h1>
            <p className="mt-3 text-sm text-stone-500">
              経路と写真を整理しています。
            </p>
          </section>
        )}

        {screen === "detail" && activeRoute && (
          <section className="space-y-5">
            <h1 className="text-2xl font-bold">道案内の確認</h1>
            <div className="rounded-2xl border bg-white p-4">
              <p className="text-sm text-stone-500">出発地</p>
              <p className="font-semibold">{activeRoute.start}</p>
              <p className="my-2 text-emerald-700">↓</p>
              <p className="text-sm text-stone-500">目的地</p>
              <p className="font-semibold">{activeRoute.goal}</p>
            </div>
            <div className="space-y-3">
              {photos.map((photo, i) => (
                <div key={photo.id} className="overflow-hidden rounded-xl border bg-white">
                  <img
                    src={photo.preview}
                    alt={`経路の写真 ${i + 1}`}
                    className="h-52 w-full object-cover"
                  />
                  <div className="p-3">
                    <p className="font-semibold">目印 {i + 1}</p>
                    <p className="mt-1 text-sm text-stone-500">
                      曲がる方向・距離の案内は、経路 API の接続後に表示します。
                    </p>
                  </div>
                </div>
              ))}
            </div>
            <button
              className={button}
              onClick={() => setScreen("routes")}
            >
              公開画面へ
            </button>
            <button
              className={secondary}
              onClick={() => setScreen("create")}
            >
              写真を追加・修正する
            </button>
          </section>
        )}

        {screen === "routes" && (
          <section className="space-y-4">
            <h1 className="text-2xl font-bold">作った道を公開する</h1>
            {routes.length === 0 ? (
              <p className="rounded-xl bg-white p-5 text-sm text-stone-500">
                まだ道案内がありません。まず「道を作る」から作成してください。
              </p>
            ) : (
              routes.map((route) => (
                <label
                  key={route.id}
                  className="flex items-start gap-3 rounded-xl border bg-white p-4"
                >
                  <input
                    type="checkbox"
                    className="mt-1 h-5 w-5 accent-emerald-700"
                    checked={selected.includes(route.id)}
                    onChange={(e) =>
                      setSelected((old) =>
                        e.target.checked
                          ? [...old, route.id]
                          : old.filter((id) => id !== route.id)
                      )
                    }
                  />
                  <span className="flex-1">
                    <span className="block font-semibold">
                      {route.start} → {route.goal}
                    </span>
                    <span className="mt-1 block text-sm text-stone-500">
                      {route.published ? "公開済み" : "下書き"}
                    </span>
                    <button
                      className="mt-2 text-sm text-emerald-700 underline"
                      onClick={(e) => {
                        e.preventDefault();
                        setActiveRoute(route);
                        setScreen("detail");
                      }}
                    >
                      詳細を見る
                    </button>
                  </span>
                </label>
              ))
            )}
            <button
              className={button}
              disabled={selected.length === 0}
              onClick={publishRoutes}
            >
              選択した道を公開する
            </button>
          </section>
        )}

        {screen === "published" && (
          <section className="space-y-4 rounded-2xl border bg-white p-5">
            <h1 className="text-2xl font-bold">公開処理が完了しました</h1>
            <p className="text-sm text-stone-600">
              現在は画面確認用です。実際の共有 URL はバックエンド接続後に発行します。
            </p>
            {routes.filter((r) => selected.includes(r.id)).map((r) => (
              <div key={r.id} className="rounded-xl bg-stone-50 p-3">
                <p className="font-semibold">{r.start} → {r.goal}</p>
                <p className="mt-1 text-sm text-emerald-700">公開済み（試作）</p>
              </div>
            ))}
            <button className={button} onClick={() => setScreen("home")}>
              ホームへ戻る
            </button>
          </section>
        )}
      </div>
    </main>
  );
}
